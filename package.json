{
  "name": "image-tool-box",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "pnpm --filter @imagetoolbox/web dev",
    "dev:desktop": "pnpm --parallel --stream --filter @imagetoolbox/web --filter @imagetoolbox/desktop dev",
    "build": "pnpm build:web && pnpm build:desktop-renderer",
    "build:web": "pnpm --filter @imagetoolbox/web build:web",
    "build:desktop-renderer": "pnpm --filter @imagetoolbox/web build:desktop",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "dist:win": "pnpm build:desktop-renderer && pnpm --filter @imagetoolbox/desktop dist:win",
    "dist:mac": "pnpm build:desktop-renderer && pnpm --filter @imagetoolbox/desktop dist:mac",
    "dist:linux": "pnpm build:desktop-renderer && pnpm --filter @imagetoolbox/desktop dist:linux"
  }
}
